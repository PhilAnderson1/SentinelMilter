[Unit]
Description=SentinelMilter AI mail filter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sentinelmilter
Group=sentinelmilter
RuntimeDirectory=sentinelmilter
RuntimeDirectoryMode=0750
StateDirectory=sentinelmilter
StateDirectoryMode=0750
ExecStart=/usr/local/sbin/sentinelmilter --config /etc/sentinelmilter/sentinelmilter.yaml
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/sentinelmilter /var/lib/sentinelmilter

[Install]
WantedBy=multi-user.target
